  3.97453204241543*^9, 
  3.974532045838793*^9}},ExpressionUUID->"53cc474d-2145-7149-be83-\
5bf72b93bb72"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Subsection"],
 ". naloga:"
}], "Subsection",
 CellChangeTimes->{{3.7841038598013687`*^9, 3.7841038647076144`*^9}, {
  3.7841091087701426`*^9, 3.7841091100201426`*^9}, {3.9091249382658157`*^9, 
  3.9091249448005333`*^9}},ExpressionUUID->"978d1fbe-31a9-4b03-ae4e-\
fccf848ef974"],

Cell[TextData[{
 "1. Priredite polinom  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"y", "-", "1"}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["x", "3"], 
       SuperscriptBox["y", "5"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "7"], "x", " ", "y", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         RowBox[{"2", "x", " ", "y"}], "+", 
         SuperscriptBox["y", "3"]}], ")"}]}]}], ")"}], "2"], 
   TraditionalForm]],ExpressionUUID->"0de55297-f911-495c-a7c1-ad07f83b627c"],
 "  spremenljivki ",
 StyleBox["q", "Code"],
 ".\n2. Raz\[SHacek]irite ga tako, da dobite vsoto monomov. Poi\[SHacek]\
\[CHacek]ite ustrezno funkcijo v dokumentaciji.\n3. Razvijte polinom po \
potencah ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "adc22a02-b63c-4229-ac99-1b2abd160066"],
 "  (koeficienti bodo polinomi v ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "add2dbfe-6681-4756-99b2-8f2a923a2a42"],
 "). Pomagajte si s funkcijo ",
 ButtonBox["Collect",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Collect"],
 ".\n4. S funkcijo ",
 ButtonBox["Exponent",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Exponent"],
 " poi\[SHacek]\[CHacek]ite najvi\[SHacek]ji potenci spremenljivk, ki se \
pojavita v polinomu."
}], "Text",
 CellChangeTimes->{{3.7847525225458164`*^9, 3.784752771358223*^9}, {
  3.784754173846651*^9, 3.7847541804872246`*^9}, {3.942732990868391*^9, 
  3.942733202069211*^9}},ExpressionUUID->"3ed3f7ec-319f-46a4-aec3-\
43ed970b3fa0"],

Cell[BoxData[{
 RowBox[{"q", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], 
     RowBox[{"(", 
      RowBox[{"y", "-", "1"}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"x", "^", "3"}], 
     RowBox[{"y", "^", "5"}]}], "+", 
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", "q", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{"q", ",", "x"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Exponent", "[", 
  RowBox[{"q", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9745324796626434`*^9, 3.974532512877346*^9}, {
  3.9745326324765434`*^9, 
  3.974532747716217*^9}},ExpressionUUID->"93c74958-ad46-4fbd-84b2-\
0349589bfc9b"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
